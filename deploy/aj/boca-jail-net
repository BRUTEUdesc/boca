#!/bin/bash
# Bloqueia toda a rede (inclusive localhost) do usuário bocajail, que roda o código dos times.
# Idempotente. Chamado por boca-jail-net.service no boot e por deploy/setup-aj.sh.
set -eu
for ipt in iptables ip6tables; do
    "$ipt" -C OUTPUT -m owner --uid-owner bocajail -j REJECT 2>/dev/null ||
        "$ipt" -I OUTPUT 1 -m owner --uid-owner bocajail -j REJECT
done
